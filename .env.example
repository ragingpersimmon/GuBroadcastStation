# --- 5protocol hook ---
# submodule checkout (news_ingest + news_signal_engine)
FIVEPROTOCOL_PATH=vendor/5protocol
# live regime, tailnet only
FIVEPROTOCOL_NEWS_URL=http://nebulizer:8699/news.json
# same key the garden dashboard relay uses
PHONE_PUSH_KEY=

# --- site (droplet) ---
GBS_SITE_NAME=Gu Broadcasting Station
GBS_SITE_URL=https://gubs.ca
GBS_SITE_OUT=/var/www/gubroadcast
GBS_DATA_DIR=/opt/gubroadcast/data
GBS_RUNDOWN_SIZE=12

# --- local desks (blank = Vancouver + DriveBC Metro Vancouver) ---
# show clock
GBS_TZ=America/Vancouver
# e.g. Coquitlam -- Celeste's forecast
GBS_LOCAL_NAME=
GBS_LOCAL_LAT=
GBS_LOCAL_LON=
# Open511 events JSON -- Flip's traffic; blank = DriveBC around Metro Vancouver
GBS_TRAFFIC_OPEN511_URL=
GBS_TRAFFIC_LINK=https://www.drivebc.ca/

# --- editorial LLM (OpenAI-compatible; Strata over StarNet or strata_tunnel.py) ---
LLM_BASE_URL=http://kwon9000:8080/v1
LLM_MODEL=strata
LLM_API_KEY=

# --- anchor studio ---
# comfy (local InfiniteTalk + TTS, free) | heygen (paid)
ANCHOR_ENGINE=comfy
# GPU handoff on the 5090: free the 27B while ComfyUI renders, then bring it back
# none | ollama | command
GBS_GPU_HANDOFF=none
# ollama mode: unload via keep_alive=0
OLLAMA_URL=http://kwon9000:11434
# command mode, e.g. ssh kwon9000 "systemctl stop llama-server"
GBS_LLM_UNLOAD_CMD=
# e.g. ssh kwon9000 "systemctl start llama-server"
GBS_LLM_RELOAD_CMD=
HEYGEN_API_KEY=
# 1 = watermarked test renders (no credits); set 0 to go live
HEYGEN_TEST=1
# keep 0 for comfy: gubroadcast-studio.timer renders in the background
GBS_RENDER=0
# 0 = per-show render_top in newsroom.json
GBS_RENDER_TOP=0
COMFY_URL=http://kwon9000:8188

# --- The Gu Briefing (newsletter) ---
# file = write previews to data/newsletter/outbox (no email) | kit = send via Kit
GBS_NEWSLETTER_PROVIDER=file
# Kit > Settings > Developer > API key (v4)
KIT_API_KEY=
# optional: a Classic template id; blank = account default
KIT_EMAIL_TEMPLATE_ID=
# broadcast is scheduled this far ahead, so it can be cancelled in Kit
KIT_SEND_DELAY_MIN=10

# --- site extras ---
# web-only stories per desk each edition (fills thin sections; not read on air). 0 = off
GBS_SITE_EXTRA_PER_DESK=3
# Openverse CC0 / public-domain topic images. 0 = off
GBS_STOCK_IMAGES=1

# --- sign-in + membership (gubroadcast-account.service, docs/MEMBERSHIP.md) ---
# random 48+ chars; deploy/update.sh fills it in if blank
GBS_SESSION_SECRET=
GBS_ACCOUNT_PORT=8710
# OAuth clients; redirect URI for each: https://gubs.ca/auth/<provider>/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
# Stripe (restricted key: write Checkout Sessions, Customer portal, Customers, Subscriptions; read Prices)
STRIPE_SECRET_KEY=
# webhook https://gubs.ca/billing/webhook, events checkout.session.completed + customer.subscription.*
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=
STRIPE_PRICE_FOUNDING=
