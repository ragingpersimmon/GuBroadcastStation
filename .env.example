# --- 5protocol hook ---
FIVEPROTOCOL_PATH=vendor/5protocol          # submodule checkout (news_ingest + news_signal_engine)
FIVEPROTOCOL_NEWS_URL=http://nebulizer:8699/news.json   # live regime, tailnet only
PHONE_PUSH_KEY=                             # same key the garden dashboard relay uses

# --- site (droplet) ---
GBS_SITE_NAME=Gu Broadcast Station
GBS_SITE_URL=https://YOURDOMAIN
GBS_SITE_OUT=/var/www/gubroadcast
GBS_DATA_DIR=/opt/gubroadcast/data
GBS_RUNDOWN_SIZE=12

# --- editorial LLM (OpenAI-compatible; Strata over StarNet or strata_tunnel.py) ---
LLM_BASE_URL=http://kwon9000:8080/v1
LLM_MODEL=strata
LLM_API_KEY=

# --- anchor studio ---
ANCHOR_ENGINE=heygen                        # heygen (Avatar III) | comfy
HEYGEN_API_KEY=
HEYGEN_TEST=1                               # 1 = watermarked test renders (no credits); set 0 to go live
GBS_RENDER=0                                # 1 = render anchor video inside `gbs run`
GBS_RENDER_TOP=3                            # segments per edition that get video
COMFY_URL=http://kwon9000:8188
