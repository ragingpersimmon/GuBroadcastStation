# --- 5protocol hook ---
FIVEPROTOCOL_PATH=vendor/5protocol          # submodule checkout (news_ingest + news_signal_engine)
FIVEPROTOCOL_NEWS_URL=http://nebulizer:8699/news.json   # live regime, tailnet only
PHONE_PUSH_KEY=                             # same key the garden dashboard relay uses

# --- site (droplet) ---
GBS_SITE_NAME=Gu Broadcasting Station
GBS_SITE_URL=https://gubs.ca
GBS_SITE_OUT=/var/www/gubroadcast
GBS_DATA_DIR=/opt/gubroadcast/data
GBS_RUNDOWN_SIZE=12

# --- local desks (off until set) ---
GBS_TZ=America/Vancouver                    # show clock
GBS_LOCAL_NAME=                             # e.g. Coquitlam -- Celeste's forecast
GBS_LOCAL_LAT=
GBS_LOCAL_LON=
GBS_TRAFFIC_OPEN511_URL=                    # Open511 events JSON (e.g. DriveBC) -- Flip's traffic
GBS_TRAFFIC_LINK=https://www.drivebc.ca/

# --- editorial LLM (OpenAI-compatible; Strata over StarNet or strata_tunnel.py) ---
LLM_BASE_URL=http://kwon9000:8080/v1
LLM_MODEL=strata
LLM_API_KEY=

# --- anchor studio ---
ANCHOR_ENGINE=comfy                         # comfy (local InfiniteTalk + TTS, free) | heygen (paid)
# GPU handoff on the 5090: free the 27B while ComfyUI renders, then bring it back
GBS_GPU_HANDOFF=none                        # none | ollama | command
OLLAMA_URL=http://kwon9000:11434            # ollama mode: unload via keep_alive=0
GBS_LLM_UNLOAD_CMD=                         # command mode, e.g. ssh kwon9000 "systemctl stop llama-server"
GBS_LLM_RELOAD_CMD=                         #               e.g. ssh kwon9000 "systemctl start llama-server"
HEYGEN_API_KEY=
HEYGEN_TEST=1                               # 1 = watermarked test renders (no credits); set 0 to go live
GBS_RENDER=0                                # keep 0 for comfy: gubroadcast-studio.timer renders in the background
GBS_RENDER_TOP=0                            # 0 = per-show render_top in newsroom.json
COMFY_URL=http://kwon9000:8188
